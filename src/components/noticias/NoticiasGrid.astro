---
import { PostsSchema } from '@/types/index.ts'; 
import PostCard from './PostCard.astro';

// Usamos las variables de entorno y traemos las últimas 9 noticias.
const url = `${import.meta.env.API_URL}/noticia?per_page=9`;
const res = await fetch(url);

if (!res.ok) {
  throw new Error('No se pudieron cargar las noticias de WordPress');
}

const json = await res.json();
const posts = PostsSchema.parse(json); 
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
  {posts.map((post) => (
      <PostCard post={post} />
  ))}
</div>