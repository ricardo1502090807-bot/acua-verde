---
interface Props {
    date: string;
}

const { date } = Astro.props;

const formatDate = (dateString: string) => {
    const date = new Date(dateString);
    return date.toLocaleDateString('es-ES', { 
        day: 'numeric', 
        month: 'short', 
        year: 'numeric' 
    });
};
---

<time datetime={date} class="text-sm text-gray-500 font-medium">
    {formatDate(date)}
</time>