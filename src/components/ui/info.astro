---
import Icon from "node_modules/astro-icon/components/Icon.astro"
import { OpcionesGlobalesSchema } from '@/types';

// Derivamos dinámicamente la URL base de tu API de entorno
const baseWpUrl = import.meta.env.API_URL.split('/wp/v2')[0];
const response = await fetch(`${baseWpUrl}/acuaverde/v1/opciones`);
const json = await response.json();
const opciones = OpcionesGlobalesSchema.parse(json);
---

<div class="w-full flex flex-col gap-6">
  <h3 class="text-xl font-bold text-gray-900 border-b border-gray-200 pb-2">
    Información de Contacto
  </h3>
  
  <div class="space-y-4 text-gray-600 text-base">
    <p class="flex items-center gap-3">
      <Icon name="mdi:account" class="w-5 h-5 text-acua-verde-600 shrink-0" />
      <span><strong>Representante:</strong> {opciones.contacto_nombre || "Acua Verde"}</span>
    </p>
    <p class="flex items-center gap-3">
      <Icon name="mdi:email" class="w-5 h-5 text-acua-verde-600 shrink-0" />
      <span><strong>Correo electrónico:</strong> <a href={`mailto:${opciones.contacto_email}`} class="hover:text-acua-verde-700 underline transition-colors">{opciones.contacto_email || "contacto@acuaverde.com"}</a></span>
    </p>
    <p class="flex items-center gap-3">
      <Icon name="mdi:phone" class="w-5 h-5 text-acua-verde-600 shrink-0" />
      <span><strong>Teléfono / WhatsApp:</strong> {opciones.contacto_numero || "+593 99 999 9999"}</span>
    </p>
  </div>

  <div class="pt-2">
    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Nuestras Redes Oficiales</p>
    <div class="flex items-center gap-3">
      {opciones.contacto_redes_instagram && (
        <a href={opciones.contacto_redes_instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="bg-gray-100 hover:bg-acua-verde-600 hover:text-white p-2.5 rounded-xl transition-all duration-200 text-gray-600 shadow-sm">
          <Icon name="mdi:instagram" class="w-5 h-5" />
        </a>
      )}
      {opciones.contacto_redes_x && (
        <a href={opciones.contacto_redes_x} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="bg-gray-100 hover:bg-acua-verde-600 hover:text-white p-2.5 rounded-xl transition-all duration-200 text-gray-600 shadow-sm">
          <Icon name="simple-icons:x" class="w-4 h-4" />
        </a>
      )}
      {opciones.contacto_redes_facebook && (
        <a href={opciones.contacto_redes_facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="bg-gray-100 hover:bg-acua-verde-600 hover:text-white p-2.5 rounded-xl transition-all duration-200 text-gray-600 shadow-sm">
          <Icon name="mdi:facebook" class="w-5 h-5" />
        </a>
      )}
    </div>
  </div>
</div>