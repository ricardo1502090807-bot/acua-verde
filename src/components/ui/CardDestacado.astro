---
import { PostsSchema } from '@/types/index.ts';

const url = `${import.meta.env.API_URL}/investigaciones?per_page=1`; // Para que se vea la última investigación subida
const res = await fetch(url);

if (!res.ok) {
  throw new Error('No se pudieron cargar las investigaciones para la tarjeta');
}

const json = await res.json();
const investigacionDestacada = PostsSchema.parse(json); // aquí parseamos el json que nos devuelve la api para que sea un objeto de tipo PostSchema
---

<div class="w-full h-50 relative rounded-2xl overflow-hidden shadow-md">
          
    {investigacionDestacada.map((investigacionDestacada: any) => ( // aquí mapeamos las investigaciones que nos devuelve la api y las renderizamos en la tarjeta
        <div class="w-full h-full shrink-0 relative">
               
            <img 
                src={investigacionDestacada.featured_images?.large?.url || investigacionDestacada.featured_images?.medium?.url || ''} 
                alt={investigacionDestacada.title?.rendered || "Imagen de investigación"} 
                class="w-full h-full object-cover"
                loading="eager" 
            />
                <!--este es un cuadro casi transparente para que se vea el titulo de la investigacion -->
            <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-4 text-white">
                <div class="flex flex-col gap-2 max-w-xl">
                    <a href={`/investigaciones/${investigacionDestacada.slug}`} class="hover:underline">
                        
                        <h1 class="text-xl md:text-xl leading-tight font-medium font-display" set:html={investigacionDestacada.title?.rendered}>
                        </h1>
                    </a>            
                        
                    <!-- Muestra el subtítulo personalizado de ACF si existe, o el extracto por defecto -->
                    <h2 class="text-xs md:text-sm font-sans opacity-90 line-clamp-2" set:html={investigacionDestacada.acf?.subtitulo || investigacionDestacada.excerpt?.rendered}>
                    </h2>
                </div>
            </div>
        </div>
    ))} 

</div>