---
    import { Image } from "astro:assets"
    import carru1 from '@/assets/carru1.jpg'
---

<div class="w-full h-50 relative rounded-2xl overflow-hidden shadow-md">
          
    <Image src={carru1} alt="Minería ilegal en la Amazonía" class=" absolute inset-0 w-full h-full object-cover" />
    
    <div class="absolute inset-0 bglinear-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-5 text-white">
    <div class="flex flex-col gap-2 max-w-xl md:max-w-2xl">
        <h1 class="text-lg md:text-xl leading-tight font-medium font-display">
        Leyes impuestas
        </h1>            
        
        <h2 class="text-xs md:text-sm font-sans opacity-90">
        Leyes aprobadas por el gobierno a favor de la minería ilegal.
        </h2>

        <button class="text-sm md:text-lg font-sans opacity-90"> 
            Leer Investigación  
        </button>

    </div>
    </div>

</div>