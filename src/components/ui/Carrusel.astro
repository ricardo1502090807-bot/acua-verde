---
  import { Image } from "astro:assets"
  import carru1 from '@/assets/carru1.jpg'
  import carru2 from '@/assets/carru2.jpg'
  import carru3 from '@/assets/carru3.jpg'
---

<section class="relative w-full overflow-hidden  shadow-xl h-75 md:h-112.5 shrink-0">   <!--aquí el relative que la imagenes no se antepongan  y el hidden que se escondan hasta que se llame la otra el shrink-0 para que se mantenga el tamaño del carrusel y no se aplaste al hacerse pequeño --> 
      
    <div id="carrusel" class="flex w-full h-full transition-transform duration-700 ease-in-out"> <!-- ease-in-out hace que se cambien rapido al principio y en el centro y al final sea haga despacio -->
        
        <div class="w-full h-full shrink-0 relative">
            <Image  src={carru1} alt="Minería ilegal en la Amazonía" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-6 text-white"> <!--es un cuadro casi tranparente en dode van los h1 y h2 para que no interfieran con la imagenes y se pueda leer bien -->
                <div class="flex flex-col gap-3 max-w-xl md:max-w-2xl">
                    <h1 class="text-xl md:text-5xl leading-tight font-medium font-display"><!--aquí hice un cuadro aparte para cada h y así editarlos por separado la fuente y el tamaño -->
                        La Amazonía frente al avance de la minería ilegal
                    </h1>            
                    <h2 class="text-sm md:text-lg font-sans opacity-90">
                        Un análisis profundo sobre el impacto ambiental y social de la minería ilegal en la región amazónica.
                    </h2>
                </div>
            </div>
        </div>
        
        <div class="w-full h-full shrink-0 relative">
            <Image  src={carru2} alt="Minería ilegal en la Amazonía" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
                <div class="flex flex-col gap-3 max-w-xl md:max-w-2xl">
                    <h1 class="text-xl md:text-5xl leading-tight font-medium font-display">
                        El Problema de los deshechos
                    </h1>           
                    <h2 class="text-sm md:text-lg font-sans opacity-90">
                        Relatos de las comunidades afectadas.
                    </h2>
                </div>
            </div>
        </div>

        <div class="w-full h-full shrink-0 relative">
            <Image  src={carru3} alt="Minería ilegal en la Amazonía" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
                <div class="flex flex-col gap-3 max-w-xl md:max-w-2xl">
                    <h1 class="text-xl md:text-5xl leading-tight font-medium font-display">
                        Leyes impuestas
                    </h1>           
                    <h2 class="text-sm md:text-lg font-sans opacity-90">
                        Leyes aprobadas por el gobierno a favor de la minería ilegal.
                    </h2>
                </div>
            </div>
        </div>
    </div>
    <button id="anterior-btn" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-20 h-20 rounded-full flex items-center justify-center transition-all z-20 focus:outline-none">
    ❮
    </button><!--los botones de las flechas llevan top y translate-y-1/2 q  ue hace que se centre muy bien, el z-20 es como la prioridad antes estaban en 10 y no se mostraban en las demas imagenes del carrusel -->
    
    <button id="despues-btn" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-20 h-20 rounded-full flex items-center justify-center transition-all z-20 focus:outline-none">
    ❯

    </button>
</section>


<script>
  const carrusel = document.getElementById('carrusel');
  const anteriorbtn = document.getElementById('anterior-btn'); //se llaman los botones y el carrusel para poder manipularlos con js
  const despuesbtn = document.getElementById('despues-btn');

  const slides = carrusel ? Array.from(carrusel.children) : [];
  let indiceActual = 0;

  function mostrarSlide(indice: number) {
    if (!carrusel) return;
    carrusel.style.transform = `translateX(-${indice * 100}%)`;
  }
  despuesbtn?.addEventListener('click', ()=>{
    indiceActual =(indiceActual +1) % slides.length;//se mueven por indices, la primera foto es 0 y al sumar 1 se pasa a la siguiente, como se divide y se obtine el residuo solo en la ultima foto que el resultado es 0 se vuelve a la primera foto, el % es para que vuelva al primer slide cuando llegue al ultimo
    mostrarSlide(indiceActual);
  });
  anteriorbtn?.addEventListener('click', ()=>{
    indiceActual =(indiceActual -1 + slides.length) % slides.length;//el + slides.length es para que no de un numero negativo al restar 1 y el % slides.length es para que vuelva al primer slide cuando llegue al ultimo
    mostrarSlide(indiceActual);
  });
  
</script>