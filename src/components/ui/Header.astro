---
    import { Image } from "astro:assets"
    import Logo from "@/assets/LOGO.png"
    import MainNav from "./MainNav.astro"
    import Icon from "node_modules/astro-icon/components/Icon.astro"
---
<header
  class="min-h-30 relative"
>
  <div class="bg-acua-verde-800 w-full px-6 xl:px-16 min-h-10 py-2 flex flex-col lg:flex-row items-center justify-between text-acua-verde-300 text-sm">

    <p class="mb-2 lg:mb-0 text-center lg:text-left">
      Periodismo ambiental independiente desde la Amazonía.
    </p>

    <div class="flex items-center gap-6 lg:gap-8">
      
      <div class="flex items-center gap-4">
        <a href="#" target="_blank" aria-label="Instagram" class="hover:opacity-80 transition-opacity">
          <Icon name="mdi:instagram" class="w-4 h-4" />
        </a>
        
        <a href="#" target="_blank" aria-label="X (Twitter)" class="hover:opacity-80 transition-opacity">
          <Icon name="simple-icons:x" class="w-4 h-4" />
        </a>
        
        <!-- <a href="#" target="_blank" aria-label="Facebook" class="hover:opacity-80 transition-opacity">
          <Icon name="mdi:facebook" class="w-4 h-4" />
        </a>

        <a href="#" target="_blank" aria-label="YouTube" class="hover:opacity-80 transition-opacity">
          <Icon name="mdi:youtube" class="w-4 h-4" />
        </a> -->
      </div>

      <div class="flex items-center gap-2">
        <input 
          type="text" 
          placeholder="Buscar..." 
          class="bg-transparent border-none outline-none text-sm text-acua-verde-300 placeholder:text-acua-verde-300/70 w-24 focus:w-32 lg:w-32 lg:focus:w-40 transition-all"
        />
        <button aria-label="Buscar" class="hover:opacity-80 transition-opacity">
          <Icon name="mdi:magnify" class="w-5 h-5" />
        </button>
      </div>

    </div>

  </div>
  
  <div class="bg-acua-verde-200 w-full px-6 2xl:px-16 py-4 flex flex-col 2xl:flex-row items-center justify-between gap-4 2xl:gap-6 text-acua-verde-300 text-sm">
      <Image 
          src={Logo} 
          alt={"Imagen Logo"} 
          format="avif" 
          width={250} 
          height={100} 
          class="w-50 2xl:w-62.5 h-auto shrink-0" 
        />
      <MainNav />
      <button class="bg-acua-verde-600 text-white px-8 py-2.5 rounded-full font-semibold hover:bg-acua-verde-800 transition-colors whitespace-nowrap shrink-0"> 
        Leer Investigación
      </button>
  </div>

</header>
