---
    import { Image } from "astro:assets"
    import Logo from "@/assets/LOGO.png"
import MainNav from "./MainNav.astro"
---
<header
  class="min-h-30 relative"
>
  <div class="bg-acua-verde-800 min-h-10 flex items-center">
  
      <p>Periodismo ambiental independiente desde la Amazonía.</p>

    </div>
  </div>
  <div class="relative max-w-7xl mx-auto bg-acua-verde-100 flex flex-col items-center lg:flex-row lg:justify-between">
      <Image src={Logo} alt={"Imagen Logo"} format="avif" width={200} height={200} />
      <MainNav />
  </div>

</header>
