---
import { Image } from "astro:assets"
import Logo from "@/assets/LOGO.svg"
import MainNav from "./MainNav.astro"
import { Icon } from 'astro-icon/components'
// para que no se borre lko que scribimos en el buscador
const urlObj = new URL(Astro.request.url);
const queryActual = urlObj.searchParams.get('q') || '';
const estaBuscando = queryActual.trim() !== '';
---

<header class="min-h-30 relative">
  <!-- 1. Barra Superior (Info a la izquierda, Redes y Buscador a la derecha) -->
  <div class="bg-acua-verde-800 w-full px-6 xl:px-16 min-h-10 py-2 flex flex-col lg:flex-row items-center justify-between text-acua-verde-300 text-sm gap-4 lg:gap-0">

    <p class="text-center lg:text-left">
      Periodismo ambiental independiente desde la Amazonía.
    </p>

    <!-- Contenedor derecho: Redes sociales + Buscador -->
    <div class="flex flex-col sm:flex-row items-center gap-4 xl:gap-6 w-full lg:w-auto justify-end">
      
      <!-- Iconos de Redes Sociales -->
      <div class="flex items-center gap-4 shrink-0">
        <a href="#" target="_blank" aria-label="Instagram" class="hover:opacity-80 transition-opacity">
          <Icon name="mdi:instagram" class="w-4 h-4" />
        </a>
        
        <a href="#" target="_blank" aria-label="X (Twitter)" class="hover:opacity-80 transition-opacity">
          <Icon name="simple-icons:x" class="w-4 h-4" />
        </a>
      </div>
<div class="flex items-center gap-2 w-full max-w-xs sm:w-auto">
        
        <!-- FLECHA SIMPLE: Solo aparece si el usuario hizo una búsqueda -->
        {estaBuscando && (
    <a 
      href="/buscar" 
      title="Limpiar búsqueda" 
      class="text-white hover:text-acua-verde-300 text-xl font-bold p-1 transition-colors focus:outline-none"
    >
      <Icon name="mdi:arrow-left" class="w-5 h-5 text-white hover:text-acua-verde-100 transition-colors" />
    </a>
  )}

        <!-- Formulario de búsqueda universal -->
        <form action="/buscar" method="GET" class="relative flex items-center w-full sm:w-64">
          <input 
            type="text" 
            name="q" 
            placeholder="Buscar en el sitio..." 
            value={queryActual}
            required
            class="w-full px-4 py-1.5 text-sm rounded-full border border-acua-verde-500 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-acua-verde-600 transition-all placeholder:text-gray-400"
          />
          <button 
            type="submit" 
            aria-label="Buscar"
            class="absolute right-3 text-acua-verde-800 hover:opacity-70 transition-opacity cursor-pointer focus:outline-none"
          >
            <Icon name="mdi:magnify" class="w-5 h-5 text-acua-verde-800 transition-colors group-hover:text-acua-verde-600" />
          </button>
        </form>
      </div>
    </div>

  </div>
  
  <!-- 2. Barra Inferior (Logo y Menú de Navegación) -->
  <div class="bg-acua-verde-200 w-full px-6 2xl:px-16 py-4 2xl:py-0 2xl:h-[170px] flex flex-col 2xl:flex-row items-center justify-between gap-4 2xl:gap-6 text-acua-verde-300 text-sm">
   <a href="/" class="hover:opacity-90 transition-opacity shrink-0">
      <Image 
          src={Logo} 
          alt="Imagen Logo Acua Verde" 
          width={300} 
          height={120} 
          class="w-50 2xl:w-50 h-auto" 
      />
    </a>
    <!-- Tu navegación limpia que llama a MainNav.astro -->
    <MainNav />

  </div>
</header>