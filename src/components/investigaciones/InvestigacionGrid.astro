---
import { InvestigacionesSchema } from '@/types/index.ts'; 
import InvestigacionCard from './InvestigacionCard.astro';

// Hacemos la petición agregando explícitamente page=1 para calcular las cabeceras correctamente
const url = `${import.meta.env.PUBLIC_API_URL}/wp-json/wp/v2/investigaciones?per_page=9&page=1`;
const res = await fetch(url);

if (!res.ok) {
  throw new Error('No se pudieron cargar las investigaciones de WordPress');
}

const json = await res.json();
const investigaciones = InvestigacionesSchema.parse(json); 

// ESTRATEGIA RESILIENTE: Si WordPress no expone 'x-wp-totalpages' por CORS o por ser un CPT personalizado,
// verificamos si el arreglo llegó lleno (9 ítems). Si está lleno, forzamos la aparición del botón.
const wpTotalPages = res.headers.get('x-wp-totalpages');
const totalPages = wpTotalPages ? parseInt(wpTotalPages, 10) : (investigaciones.length === 9 ? 999 : 1);
---

{/* Configuramos el contenedor con data-type="investigacion" */}
<div class="content-wrapper" data-total-pages={totalPages} data-type="investigacion">
  
  {/* Añadimos la clase content-grid para que el JS sepa dónde insertar las nuevas tarjetas */}
  <div class="content-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
    {investigaciones.map((investigacion) => (
        <InvestigacionCard investigacion={investigacion} />
    ))}
  </div>

  {/* El botón ahora aparecerá de forma segura si totalPages se forzó a 999 */}
  {totalPages > 1 && (
    <div class="load-more-container flex justify-center mt-16">
      <button 
        class="load-more-btn px-8 py-3 bg-acua-verde-600 text-white font-semibold rounded-xl shadow-sm hover:bg-acua-verde-700 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Cargar más investigaciones
      </button>
    </div>
  )}
</div>

{/* Script genérico optimizado para escuchar las grillas de contenido */}
<script>
  const wrappers = document.querySelectorAll('.content-wrapper');

  wrappers.forEach(wrapper => {
    const grid = wrapper.querySelector('.content-grid');
    const btn = wrapper.querySelector('.load-more-btn') as HTMLButtonElement;
    const btnContainer = wrapper.querySelector('.load-more-container');

    if (grid && btn) {
      const totalPages = parseInt(wrapper.getAttribute('data-total-pages') || '1', 10);
      const contentType = wrapper.getAttribute('data-type') || 'noticia';
      let currentPage = 1;

      btn.addEventListener('click', async () => {
        currentPage++;
        btn.disabled = true;
        btn.innerText = 'Cargando...';

        try {
          const response = await fetch(`/api/more-content?type=${contentType}&page=${currentPage}`);
          
          if (response.ok) {
            const html = await response.text();
            
            // CONTROL DE FLUJO SÚPER SEGURO: Si el HTML devuelto está vacío, 
            // significa que la página de WordPress no tenía más contenido. Eliminamos el botón.
            if (!html.trim() && btnContainer) {
              btnContainer.remove();
              return;
            }
            
            grid.insertAdjacentHTML('beforeend', html);
          } else if (response.status === 404 && btnContainer) {
            // Si la API de WordPress devuelve un error 404 (página no encontrada), removemos el botón
            btnContainer.remove();
            return;
          }
        } catch (error) {
          console.error('Error al cargar más contenido:', error);
        } finally {
          btn.disabled = false;
          btn.innerText = `Cargar más ${contentType === 'noticia' ? 'noticias' : 'investigaciones'}`;

          if (currentPage >= totalPages && btnContainer) {
            btnContainer.remove();
          }
        }
      });
    }
  });
</script>