---
import { InvestigacionesSchema } from '@/types/index.ts';
import { fetchWPPaginated } from '@/lib/wordpress';
import InvestigacionCard from './InvestigacionCard.astro';

const url = `${import.meta.env.API_URL}/investigaciones?per_page=9&page=1`;
const { items: investigaciones, totalPages } = await fetchWPPaginated(url, InvestigacionesSchema);
---

<div class="content-wrapper" data-total-pages={totalPages} data-type="investigacion">
  <div class="content-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
    {investigaciones.map((investigacion) => (
        <InvestigacionCard investigacion={investigacion} />
    ))}
  </div>

  {totalPages > 1 && (
    <div class="load-more-container flex justify-center mt-16">
      <button
        class="load-more-btn px-8 py-3 bg-acua-verde-600 text-white font-semibold rounded-xl shadow-sm hover:bg-acua-verde-700 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Cargar más investigaciones
      </button>
    </div>
  )}
</div>

<script>
  import '../../scripts/load-more';
</script>