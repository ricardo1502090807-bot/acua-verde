---
import Layout from '@/layouts/layout.astro';
import { BaseWPSchema } from '@/types';
const url = 'http://acua-verde.local/wp-json/wp/v2/pages?slug=nosotros'
const res = await fetch(url);
const json = await res.json();
const data = BaseWPSchema.parse(json[0]);
console.log(data); 
---
<Layout
  title='Nosotros'
>
  <h1>{json[0].title.rendered}</h1>
  <h2>{json[0].content.rendered}</h2>
  image: {json[0].featured_media}
</Layout>
