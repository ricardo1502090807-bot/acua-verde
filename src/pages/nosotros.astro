---
import { Picture } from 'astro:assets';
import Layout from '@/layouts/layout.astro';
import { NosotrosPageSchema } from '@/types/index.ts';
import InfoContacto from '@/components/ui/info.astro';

const url = `${import.meta.env.PUBLIC_API_URL}/wp-json/wp/v2/pages?slug=nosotros`;
const res = await fetch(url);
const json = await res.json();
const data = NosotrosPageSchema.parse(json[0]);

// EXTRACCIÓN SEGURA DE IMÁGENES:
const imgPrincipal = data.acf_images_urls?.imagen_uno?.large?.url 
                  || data.acf_images_urls?.imagen_uno?.full?.url 
                  || data.acf_images_urls?.imagen_uno?.medium?.url 
                  || null;

const imgSecundaria = data.acf_images_urls?.imagen_dos?.large?.url 
                   || data.acf_images_urls?.imagen_dos?.full?.url 
                   || data.acf_images_urls?.imagen_dos?.medium?.url 
                   || null;
---

<Layout title="Nosotros - Acua Verde">
  <main class="w-full bg-gray-50 min-h-screen py-12 md:py-20">
    {/* AMPLIADO: Cambiamos max-w-4xl/5xl a max-w-6xl para dar más amplitud general */}
    <div class="max-w-6xl mx-auto px-6 lg:px-8 space-y-16">
      
      {/* 1. CABECERA: Título y Subtítulo */}
      <header class="text-center space-y-6">
        <h1 class="text-4xl md:text-6xl font-black text-gray-900 tracking-tight" set:html={data.title.rendered}></h1>
        {data.acf?.subtitle && (
          <p class="text-xl md:text-2xl text-acua-verde-700 font-medium leading-relaxed max-w-3xl mx-auto" set:html={data.acf.subtitle}></p>
        )}
      </header>

      {/* 2. IMAGEN PRINCIPAL PANORÁMICA (Imagen 1 de ACF) */}
      {imgPrincipal && (
        <div class="w-full h-72 md:h-112.5 rounded-3xl overflow-hidden shadow-lg border border-gray-100">
          <Picture 
            src={imgPrincipal}
            alt={`Conoce al equipo de ${data.title.rendered}`}
            width={1200}
            height={450}
            formats={['avif', 'webp']}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      {/* 3. HISTORIA Y CONTENIDO PRINCIPAL */}
      {/* AMPLIADO: Añadimos 'max-w-none' para romper el cuello de botella del plugin prose de Tailwind */}
      <div class="prose prose-lg md:prose-xl max-w-none text-gray-700 leading-relaxed text-justify prose-a:text-acua-verde-600">
        <Fragment set:html={data.content.rendered} />
      </div>

      {/* 4. MISIÓN Y VISIÓN */}
      {(data.acf?.mision || data.acf?.vision) && (
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-10 border-t border-gray-200">
          {data.acf?.mision && (
            <div class="bg-acua-verde-200 border border-acua-verde-100 rounded-3xl p-8 shadow-sm">
              <h2 class="text-2xl font-bold text-acua-verde-800 mb-4">Nuestra Misión</h2>
              <div class="text-gray-600 leading-relaxed text-justify" set:html={data.acf.mision}></div>
            </div>
          )}
          
          {data.acf?.vision && (
            <div class="bg-acua-verde-200 border border-acua-verde-100 rounded-3xl p-8 shadow-sm">
              <h2 class="text-2xl font-bold text-acua-verde-800 mb-4">Nuestra Visión</h2>
              <div class="text-gray-600 leading-relaxed text-justify" set:html={data.acf.vision}></div>
            </div>
          )}
        </section>
      )}

      {/* 5. CONTACTO E IMAGEN SECUNDARIA (Imagen 2 de ACF) */}
      <section class="bg-acua-verde-200 border border-gray-200 rounded-3xl p-8 md:p-10 shadow-sm grid grid-cols-1 lg:grid-cols-2 gap-10 items-center mt-12">
        <div>
          <InfoContacto />
        </div>
        
        {imgSecundaria && (
          <div class="w-full h-72 overflow-hidden rounded-2xl bg-gray-50 border border-gray-100">
            <Picture 
              src={imgSecundaria}
              alt="Contacto e investigación Acua Verde"
              width={600}
              height={400}
              formats={['avif', 'webp']}
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
            />
          </div>
        )}
      </section>

    </div>
  </main>
</Layout>