---
  import Layout from '@/layouts/layout.astro';
  import Icon from "node_modules/astro-icon/components/Icon.astro"
  import Carrusel from '@/components/ui/Carrusel.astro';
  import CardDestacado from '@/components/ui/CardDestacado.astro';
  import BoletinSuscripcion from '@/components/ui/BoletinSuscripcion.astro';
---
<Layout
  title='Inicio'
>
  <div class="flex flex-col min-h-screen"> <!--tenias h-250, pero es mejor el min-h-screen po0r que con el otro se me comía la imagen del final  -->
    <!-- CARRUSEL -->
    <Carrusel />
    <section class="flex-1 grid grid-cols-10 gap-6 " ><!--[70%_30%]-->
      <div class=" col-span-7 flex flex-col h-fullborder-r border-acua-verde-600 p-4 ">
        <section class="bg-acua-verde-400 flex-1 min-h-75 gap-4 mt-4 p-4 rounded-xl">
          Ultimas publicaciones
        </section>
        <section class="bg-acua-verde-200 flex-1 min-h-37.5 gap-4 mt-4 p-4 rounded-xl">
          Explora por categorías
        </section>
      </div>

      <div class=" col-span-3 flex flex-col  p-4">
        <section class="  pb-6 flex flex-col ">
          <h1 class="text-xl md:text-3xl leading-tight font-medium font-display"><!--te copie tu header -->
            Síguenos
          </h1>       
          <div class=" flex items-center gap-4">
            <a href="#" target="_blank" aria-label="Instagram" class="hover:opacity-80 transition-opacity p-2">
              <Icon name="mdi:instagram" class="w-6 h-6" />
            </a>
            
            <a href="#" target="_blank" aria-label="X (Twitter)" class="hover:opacity-80 transition-opacity p-2">
              <Icon name="simple-icons:x" class="w-6 h-6" />
            </a>
          </div>
          <!-- SUSCRIPCIÓN -->
          <BoletinSuscripcion />
        </section>
        
        <section class="bg-transparent pb-6 flex flex-col gap-3">
          <h1 class="text-xl md:text-2xl leading-tight font-medium font-display text-gray-800">
            Investigación especial
          </h1>
          <!-- CARD DESTACADO -->
          <CardDestacado />
        </section>
      </div>
    </section>
  </div>
</Layout>