---
  import Layout from '@/layouts/layout.astro';
  import { Image } from "astro:assets"
  import carru1 from '@/assets/carru1.jpg'
  import carru2 from '@/assets/carru2.jpg'
  import carru3 from '@/assets/carru3.jpg'
  import Icon from "node_modules/astro-icon/components/Icon.astro"
---
<Layout
  title='Inicio'
>
  <div class="flex flex-col h-250"> 

    <section class="relative w-full overflow-hidden  shadow-xl h-[300px] md:h-[450px] shrink-0">   <!--aquí el relative que la imagenes no se antepongan  y el hidden que se escondan hasta que se llame la otra el shrink-0 para que se mantenga el tamaño del carrusel y no se aplaste al hacerse pequeño --> 
      
      <div id="carrusel" class="flex w-full h-full transition-transform duration-700 ease-in-out"> <!-- ease-in-out hace que se cambien rapido al principio y en el centro y al final sea haga despacio -->
        
          <div class="w-full h-full flex-shrink-0 relative">
            <Image  src={carru1} alt="Minería ilegal en la Amazonía" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-6 text-white"> <!--es un cuadro casi tranparente en dode van los h1 y h2 para que no interfieran con la imagenes y se pueda leer bien -->
            <div class="flex flex-col gap-3 max-w-xl md:max-w-2xl">
        
                <h1 class="text-xl md:text-5xl leading-tight font-medium font-display"><!--aquí hice un cuadro aparte para cada h y así editarlos por separado la fuente y el tamaño -->
                  La Amazonía frente al avance de la minería ilegal
                </h1>            
                <h2 class="text-sm md:text-lg font-sans opacity-90">
                  Un análisis profundo sobre el impacto ambiental y social de la minería ilegal en la región amazónica.
                </h2>

              </div>
            </div>
          </div>
          
          <div class="w-full h-full flex-shrink-0 relative">
            <Image  src={carru2} alt="Minería ilegal en la Amazonía" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
            <div class="flex flex-col gap-3 max-w-xl md:max-w-2xl">
        
                <h1 class="text-xl md:text-5xl leading-tight font-medium font-display">
                  El Problema de los deshechos
                </h1>           
                <h2 class="text-sm md:text-lg font-sans opacity-90">
                  Relatos de las comunidades afectadas.
                </h2>
              </div>
            </div>
          </div>

          <div class="w-full h-full flex-shrink-0 relative">
            <Image  src={carru3} alt="Minería ilegal en la Amazonía" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
                <div class="flex flex-col gap-3 max-w-xl md:max-w-2xl">
            
                    <h1 class="text-xl md:text-5xl leading-tight font-medium font-display">
                      Leyes impuestas
                    </h1>           
                    <h2 class="text-sm md:text-lg font-sans opacity-90">
                      Leyes aprobadas por el gobierno a favor de la minería ilegal.
                    </h2>
                </div>
            </div>
          </div>
      </div>
      <button id="anterior-btn" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-20 h-20 rounded-full flex items-center justify-center transition-all z-20 focus:outline-none">
        ❮
      </button><!--los botones de las flechas llevan top y translate-y-1/2 q  ue hace que se centre muy bien, el z-20 es como la prioridad antes estaban en 10 y no se mostraban en las demas imagenes del carrusel -->
      
      <button id="despues-btn" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-20 h-20 rounded-full flex items-center justify-center transition-all z-20 focus:outline-none">
        ❯

      </button>
    </section>

    <section class="flex-1 grid grid-cols-[70%_30%]">
     
     
      <div class="flex flex-col border-r border-acua-verde-600 p-4 ">
        <section class=" bg-acua-verde-400 h-100">
          Ultimas publicaciones
        </section>
        <section class="bg-acua-verde-200 h-50">
          Explora por categorías
        </section>
      </div>








      <div class="flex flex-col  p-4">
        
        <section class=" bg-acua-verde-200 pb-6 flex flex-col ">
                <h1 class="text-xl md:text-3xl leading-tight font-medium font-display"><!--te copie tu header -->
                  Síguenos
                </h1>       
                <div class="flex items-center gap-4">
                    <a href="#" target="_blank" aria-label="Instagram" class="hover:opacity-80 transition-opacity p-2">
                      <Icon name="mdi:instagram" class="w-6 h-6" />
                    </a>
                    
                    <a href="#" target="_blank" aria-label="X (Twitter)" class="hover:opacity-80 transition-opacity p-2">
                      <Icon name="mdi:twitter" class="w-6 h-6" />
                    </a>
                    
                    <a href="#" target="_blank" aria-label="Facebook" class="hover:opacity-80 transition-opacity p-2">
                      <Icon name="mdi:facebook" class="w-6 h-6" />
                    </a>

                    <a href="#" target="_blank" aria-label="YouTube" class="hover:opacity-80 transition-opacity p-2">
                      <Icon name="mdi:youtube" class="w-6 h-6" />
                    </a>

                </div>
           
              <div class="bg-acua-verde-200 flex flex-col flex-1 gap-3 max-w-xl md:max-w-2xl rounded-2xl  border border-acua-verde-500 p-4 mt-4"><!--tenias h-100 pero se hacía muy estatico y se cambió por flex flex-col para hacer una bajo de otra y añadí eñ border-->
        
                <h1 class="text-xl md:text-2xl leading-tight font-medium font-display p-2">
                 Recibe historias que conectan el planetay a las personas.

                </h1>            
                <h2 class="text-sm md:text-lg font-sans opacity-90 p-2">
                  Suscribetea nuestro boletin semanal y no te pierdas nuestras investigaciones y reportajes.

                </h2>

               <div class=" items-center ">
                  <input 
                    type="text" 
                    placeholder="correo electrónico" 
                    class="bg-white border border-gray-300  outline-none text-sm text-acua-verde-300 placeholder:text-acua-verde-300/70 w-24 focus:w-32 lg:w-32 lg:focus:w-40 transition-all rounded-l-full p-2"
                  /><!--a la mayoría le añadí el p-2 que es el padding, pero mira si hay una manera mejor  -->
                  <button aria-label="Suscribirse" class="hover:opacity-80 transition-opacity bg-acua-verde-600 text-white px-4 py-2 rounded-r-full p-2">
                    Suscribirse
                  </button>
                </div>


              </div>
              
     
        </section>
        
        <section class="bg-acua-verde-200 h-50">
          Investigación especial
           <div class="bg-acua-verde-500 flex flex-col flex-1 gap-3 max-w-xl md:max-w-2xl rounded-2xl ">
        
                <h1 class="text-xl md:text-2xl leading-tight font-medium font-display p-2"><!--aquí hice un cuadro aparte para cada h y así editarlos por separado la fuente y el tamaño -->
                  La Amazonía frente al avance de la minería ilegal
                </h1>            
                <h2 class="text-sm md:text-lg font-sans opacity-90 p-2">
                  Un análisis profundo sobre el impacto ambiental y social de la minería ilegal en la región amazónica.
                </h2>

              </div>
        </section>
      </div>
    </section>
  </div>
          

</Layout>




<script>
  const carrusel = document.getElementById('carrusel');
  const anteriorbtn = document.getElementById('anterior-btn'); //se llaman los botones y el carrusel para poder manipularlos con js
  const despuesbtn = document.getElementById('despues-btn');

  const slides = carrusel ? Array.from(carrusel.children) : [];
  let indiceActual = 0;

  function mostrarSlide(indice) {
    if (!carrusel) return;
    carrusel.style.transform = `translateX(-${indice * 100}%)`;
  }
  despuesbtn?.addEventListener('click', ()=>{
    indiceActual =(indiceActual +1) % slides.length;//se mueven por indices, la primera foto es 0 y al sumar 1 se pasa a la siguiente, como se divide y se obtine el residuo solo en la ultima foto que el resultado es 0 se vuelve a la primera foto, el % es para que vuelva al primer slide cuando llegue al ultimo
    mostrarSlide(indiceActual);
  });
  anteriorbtn?.addEventListener('click', ()=>{
    indiceActual =(indiceActual -1 + slides.length) % slides.length;//el + slides.length es para que no de un numero negativo al restar 1 y el % slides.length es para que vuelva al primer slide cuando llegue al ultimo
    mostrarSlide(indiceActual);
  });
  
</script>