---
  import Layout from '@/layouts/layout.astro';
---
<Layout
  title='Inicio'
>
  <div class="flex flex-col h-250"> 

    <section class="bg-acua-verde-900 h-100 shrink-0">   
       carrusel
    </section>

    <section class="flex-1 grid grid-cols-[70%_30%]">
      <div class="flex flex-col border-r border-acua-verde-600 p-4 ">
        <section class=" bg-acua-verde-400 h-100">
          Ultimas publicaciones
        </section>
        <section class="bg-acua-verde-200 h-50">
          Explora por categorías
        </section>
      </div>
      <div class="flex flex-col  p-4">
        <section class=" bg-acua-verde-400 h-100">
          Síguenos
        </section>
        <section class="bg-acua-verde-200 h-50">
          Investigación especial
        </section>
      </div>
    </section>
  </div>
          

</Layout>