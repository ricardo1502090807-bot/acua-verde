---
// 1. OBLIGAMOS A ASTRO A PROCESAR ESTA PÁGINA EN TIEMPO REAL (SSR)
export const prerender = false;

import Layout from '@/layouts/layout.astro';
import { PostsSchema } from '@/types/index.ts';
import PostCard from '@/components/noticias/PostCard.astro';
import InvestigacionCard from '@/components/investigaciones/InvestigacionCard.astro';

const urlObj = new URL(Astro.request.url);
const query = urlObj.searchParams.get('q') || '';
const tieneFiltro = query.trim() !== '';

let resultadosUnificados = [];
let errorBuscando = false;
try {
  // 1. Armamos las URLs dinámicamente según si hay o no un filtro escrito
  const parametroBusqueda = tieneFiltro ? `?search=${encodeURIComponent(query)}` : '';
  
  const urlNoticias = `${import.meta.env.API_URL}/noticia${parametroBusqueda}`;
  const urlInvestigaciones = `${import.meta.env.API_URL}/investigaciones${parametroBusqueda}`;

  // 2. Traemos la información en paralelo
  const [resNoticias, resInvestigaciones] = await Promise.all([
    fetch(urlNoticias),
    fetch(urlInvestigaciones)
  ]);

  if (resNoticias.ok && resInvestigaciones.ok) {
    const jsonNoticias = await resNoticias.json();
    const jsonInvestigaciones = await resInvestigaciones.json();

    // Asignamos directamente los JSON (como lo dejaste configurado antes)
    const noticiasValidadas = jsonNoticias; 
    const investigacionesValidadas = jsonInvestigaciones;

    const noticiasMarcadas = noticiasValidadas.map((item: any) => ({ ...item, tipoDePost: 'noticia' }));
    const investigacionesMarcadas = investigacionesValidadas.map((item: any) => ({ ...item, tipoDePost: 'investigacion' }));

    resultadosUnificados = [...noticiasMarcadas, ...investigacionesMarcadas];
  } else {
    errorBuscando = true;
  }
} catch (error) {
  console.error("Error al cargar publicaciones:", error);
  errorBuscando = true;
}
---

<Layout title={`Resultados para: ${query}`}>
  <main class="w-full min-h-screen bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      
      <!-- Encabezado Dinámico -->
        <div class="mb-10">
        <h1 class="text-3xl font-bold font-display text-gray-800">
            {tieneFiltro ? 'Resultados de la búsqueda' : 'Todas nuestras publicaciones'}
        </h1>
        <p class="text-gray-600 mt-2">
            {tieneFiltro ? (
            <>Buscando <span class="font-semibold text-acua-verde-800">"{query}"</span> en el sitio.</>
            ) : (
            "Explora las últimas noticias e investigaciones ambientales de la Amazonía."
            )}
        </p>
        </div>

      <!-- Estado: Error de servidor -->
      {errorBuscando && (
        <div class="bg-red-50 text-red-700 p-4 rounded-xl border border-red-200">
          Hubo un problema al conectar con el servidor de WordPress.
        </div>
      )}

      <!-- Estado: No se encontró nada -->
      {!errorBuscando && resultadosUnificados.length === 0 && (
        <div class="bg-blue-50 text-blue-700 p-6 rounded-xl border border-blue-200 text-center">
          No se encontraron publicaciones que coincidan con tu búsqueda. ¡Prueba con otros términos!
        </div>
      )}
      

      <!-- Estado: Resultados encontrados -->
      {!errorBuscando && resultadosUnificados.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {resultadosUnificados.map((item: any) => {
            //  La lógica decide qué tarjeta renderizar basándose en la marca que le pusimos arriba
            if (item.tipoDePost === 'investigacion') {
              // Si es una investigación, se usa la tarjeta que se creó 
              return <InvestigacionCard investigacion={item} />; 
            } else {
              // Si es una noticia común, usamos la PostCard estándar
              return <PostCard post={item} />;
            }
          })}
        </div>
      )}

    </div>
  </main>
</Layout>