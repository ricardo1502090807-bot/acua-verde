---
// 1. OBLIGAMOS A ASTRO A PROCESAR ESTA PÁGINA EN TIEMPO REAL (SSR)
export const prerender = false;

import Layout from '@/layouts/layout.astro';
import BusquedaCard from '@/components/shared/BusquedaCard.astro';
import { PostsSchema, InvestigacionesSchema } from '@/types/index.ts';

const urlObj = new URL(Astro.request.url);

// Leemos el texto (q) o la categoría (cat)
const query = urlObj.searchParams.get('q') || '';
const categoriaId = urlObj.searchParams.get('cat') || '';

const tieneFiltroTexto = query.trim() !== '';
const tieneFiltroCategoria = categoriaId.trim() !== '';

let resultadosUnificados: any[] = [];
let errorBuscando = false;

try {
  // 1. Usamos el objeto URL para manejar los parámetros de forma nativa
  const urlNoticias = new URL(`${import.meta.env.API_URL}/noticia`);
  const urlInvestigaciones = new URL(`${import.meta.env.API_URL}/investigaciones`);

  // 2. Aumentamos el límite de resultados para que el filtro evalúe toda la base
  urlNoticias.searchParams.set('per_page', '100');
  urlInvestigaciones.searchParams.set('per_page', '100');
  
  if (tieneFiltroTexto) {
    urlNoticias.searchParams.set('search', query);
    urlInvestigaciones.searchParams.set('search', query);
  } else if (tieneFiltroCategoria) {
    urlNoticias.searchParams.set('categories', categoriaId);
    urlInvestigaciones.searchParams.set('categoria_investigacion', categoriaId);
  }

  // 3. Traemos la información en paralelo de la API (usando .toString() para enviar la URL armada)
  const [resNoticias, resInvestigaciones] = await Promise.all([
    fetch(urlNoticias.toString()),
    fetch(urlInvestigaciones.toString())
  ]);

  if (resNoticias.ok && resInvestigaciones.ok) {
    const jsonNoticias = await resNoticias.json();
    const jsonInvestigaciones = await resInvestigaciones.json();

    const noticiasMarcadas = jsonNoticias.map((item: any) => ({ ...item, tipoDePost: 'noticia' }));
    const investigacionesMarcadas = jsonInvestigaciones.map((item: any) => ({ ...item, tipoDePost: 'investigacion' }));

    const combinados = [...noticiasMarcadas, ...investigacionesMarcadas];

    // 3. APLICAMOS EL FILTRO ESTRICTO SOLICITADO (Solo coincidencias en título o categorías)
    if (tieneFiltroTexto) {
      const queryLimpia = query.toLowerCase().trim();
      
      resultadosUnificados = combinados.filter((item: any) => {
        // Validación en Título
        const coincideTitulo = item.title?.rendered?.toLowerCase().includes(queryLimpia);
        
        // Validación en Categorías
        const categorias = item.category_details || item.categories_data || [];
        const coincideCategoria = categorias.some((cat: any) => 
          cat && cat.name && cat.name.toLowerCase().includes(queryLimpia)
        );

        return coincideTitulo || coincideCategoria;
      });
    } else {
      resultadosUnificados = combinados;
    }
  } else {
    errorBuscando = true;
  }
} catch (error) {
  console.error("Error al cargar publicaciones:", error);
  errorBuscando = true;
}
---

<Layout title={tieneFiltroTexto ? `Resultados para: ${query}` : 'Explorar Publicaciones'}>
  <main class="w-full min-h-screen bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      
      <div class="mb-10">
        <h1 class="text-3xl font-bold font-display text-gray-800">
          {tieneFiltroTexto && 'Resultados de la búsqueda'}
          {tieneFiltroCategoria && 'Explorando la categoría'}
          {!tieneFiltroTexto && !tieneFiltroCategoria && 'Todas nuestras publicaciones'}
        </h1>
        <p class="text-gray-600 mt-2">
          {tieneFiltroTexto && <>Buscando <span class="font-semibold text-acua-verde-800">"{query}"</span> en el sitio.</>}
          {tieneFiltroCategoria && <>Mostrando únicamente los artículos de esta sección.</>}
          {!tieneFiltroTexto && !tieneFiltroCategoria && "Explora las últimas noticias e investigaciones ambientales de la Amazonía."}
        </p>
      </div>

      {errorBuscando && (
        <div class="bg-red-50 text-red-700 p-4 rounded-xl border border-red-200 shadow-sm">
          Hubo un problema al conectar con el servidor de WordPress. Por favor, intenta más tarde.
        </div>
      )}

      {!errorBuscando && resultadosUnificados.length === 0 && (
        <div class="bg-blue-50 text-blue-700 p-6 rounded-xl border border-blue-200 text-center shadow-sm">
          <p class="font-medium text-base mb-1">
            {tieneFiltroTexto 
              ? `No se encontraron publicaciones que coincidan estrictamente con "${query}".`
              : 'No se encontraron publicaciones en esta categoría todavía.'}
          </p>
          <p class="text-sm text-blue-600/80">Pronto subiremos nuevas investigaciones y noticias. ¡Explora otra sección!</p>
        </div>
      )}
      
      {/* 3. ESTADO: Resultados encontrados */}
      {!errorBuscando && resultadosUnificados.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {resultadosUnificados.map((item: any) => (
            <BusquedaCard item={item} />
          ))}
        </div>
      )}

    </div>
  </main>
</Layout>