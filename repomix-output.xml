@import 'tailwindcss';
@plugin "@tailwindcss/typography";

/* Centrar imagen */
.aligncenter {
    display: block;
    margin-left: auto;
    margin-right: auto;
}

/* Alinear a la izquierda y que el texto la rodee */
.alignleft {
    float: left;
    margin-right: 1.5rem;
    margin-bottom: 1rem;
}

/* Alinear a la derecha y que el texto la rodee */
.alignright {
    float: right;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
}

/* Limpiar los flotantes para que no se rompa el diseño (muy importante) */
.clear {
    clear: both;
}

