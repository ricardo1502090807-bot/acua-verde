<file path="src/components/noticias/NoticiasCard.astro">
---
import type { Post } from '@/types/index.ts';
import AutorInfo from '@/components/shared/AutorInfo.astro';
import PostMeta from '@/components/shared/PostMeta.astro';
import PostCategories from '@/components/shared/PostCategories.astro';

interface Props {
    post: Post;
}

const { post } = Astro.props;

// Imagen destacada del post
const imageUrl = post.featured_images?.medium_large?.url 
              || post.featured_images?.medium?.url 
              || null;

// Datos del Autor
const autorNombre = post.autor_custom?.nombre || 'Redacción Acua Verde';
const autorAvatar = post.autor_custom?.imagen?.thumbnail?.url 
                 || post.autor_custom?.imagen?.medium?.url 
                 || null;
---

<article class="flex flex-col group h-full">
    <div class="overflow-hidden rounded-xl aspect-[3/2] mb-4 bg-acua-verde-200 flex items-center justify-center">
        {imageUrl ? (
            <img 
                src={imageUrl} 
                alt={post.title.rendered}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
            />
        ) : (
            <span class="text-acua-verde-800 font-medium tracking-wide opacity-50">Acua Verde</span>
        )}
    </div>

    <h2 class="text-xl font-bold text-gray-900 leading-snug mb-3 group-hover:text-acua-verde-600 transition-colors">
        <a href={`/noticias/${post.slug || post.id}`} set:html={post.title.rendered}></a>
    </h2>

    {post.category_details && post.category_details.length > 0 && (
        <div class="flex flex-wrap mb-2">
            {post.category_details.map(cat => (
                <PostCategories name={cat.name} slug={cat.slug} />
            ))}
        </div>
    )}

    <div set:html={post.content.rendered} class="line-clamp-2 text-gray-600 text-sm mb-4"></div>

    {/* SECCIÓN DEL AUTOR Y METADATOS */}
    <div class="mt-auto flex items-center justify-between pt-4 border-t border-gray-100">
        <AutorInfo nombre={autorNombre} avatar={autorAvatar} />
        
        <PostMeta date={post.date} />
    </div>
</article>
</file>

<file path="src/pages/api/more-content.astro">
---
import { PostsSchema, InvestigacionesSchema } from '@/types/index.ts';
import NoticiasCard from '@/components/noticias/NoticiasCard.astro';
import InvestigacionCard from '@/components/investigaciones/InvestigacionCard.astro'; 

export const prerender = false;

const type = Astro.url.searchParams.get('type') || 'noticia';
const page = Astro.url.searchParams.get('page') || '2';

const wpEndpoint = type === 'investigacion' ? 'investigaciones' : 'noticia';
const url = `${import.meta.env.API_URL}/${wpEndpoint}?per_page=9&page=${page}`;

const res = await fetch(url);

if (!res.ok) {
    return new Response('', { status: 404 });
}

const json = await res.json();

// Declaramos explícitamente como any[] para evitar errores de tipo implícito ts(7034)
// y prevenir conflictos del compilador de Astro al renderizar componentes basados en uniones
let items: any[] = []; 

try {
    if (type === 'noticia') {
        items = PostsSchema.parse(json);
    } else if (type === 'investigacion') {
        items = InvestigacionesSchema.parse(json);
    }
} catch (error) {
    // Si una investigación de la página 2 tiene un formato inesperado en WordPress, 
    // este bloque evitará que la app colapse y verás el error detallado en tu terminal.
    console.error(`[Acua Verde API Error] Error al validar esquema Zod para ${type}:`, error);
    return new Response('', { status: 500 });
}
---

{items.map((item) => (
    type === 'noticia' 
        ? <NoticiasCard post={item} /> 
        : <InvestigacionCard investigacion={item} />
))}
</file>

<file path="src/pages/investigaciones/categoria/[slug].astro">
---
import Layout from '@/layouts/layout.astro';
import InvestigacionCard from '@/components/investigaciones/InvestigacionCard.astro';
import { InvestigacionesSchema, CategoriesSlugSchema, CategorySchema } from '@/types/index.ts';

export async function getStaticPaths() {
    // Apuntamos a la nueva taxonomía
    const res = await fetch(`${import.meta.env.API_URL}/categoria_investigacion?_fields=slug`);
    const json = await res.json();
    const categories = CategoriesSlugSchema.parse(json);
    
    return categories.map(category => ({
        params: { slug: category.slug }
    }));
}

const { slug } = Astro.params;

// Traemos los datos de la categoría específica de investigación
const catUrl = `${import.meta.env.API_URL}/categoria_investigacion?slug=${slug}`;
const catRes = await fetch(catUrl);
const catJson = await catRes.json();
const category = CategorySchema.parse(catJson[0]);

// Filtramos las investigaciones usando el ID de la taxonomía
const postsUrl = `${import.meta.env.API_URL}/investigaciones?categoria_investigacion=${category.id}`;
const postsRes = await fetch(postsUrl);
const postsJson = await postsRes.json();
const investigaciones = InvestigacionesSchema.parse(postsJson);
---

<Layout title={`Investigaciones sobre ${category.name} - Acua Verde`}>
  <main class="w-full bg-acua-verde-50 min-h-screen py-12">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      
      <div class="mb-10 border-b border-acua-verde-300 pb-4 flex flex-col gap-2">
          <span class="text-sm font-bold tracking-widest uppercase text-gray-500">Filtrando Investigaciones por:</span>
          <h1 class="text-4xl font-bold text-gray-800">
            {category.name}
          </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {investigaciones.length > 0 ? (
          investigaciones.map(investigacion => (
              <InvestigacionCard investigacion={investigacion} />
          ))
        ) : (
          <p class="text-gray-500 text-lg col-span-full">Aún no hay reportajes publicados en esta categoría.</p>
        )}
      </div>

    </div>
  </main>
</Layout>
</file>

