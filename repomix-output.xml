<file path="src/components/ui/Carrusel.astro">
---
  
  import { PostsSchema } from '@/types/index.ts';

const url = `${import.meta.env.API_URL}/noticia?per_page=3`;//para que se vean las 3 ultimas noticias subidas
const res = await fetch(url);
if (!res.ok) {
  throw new Error('No se pudieron cargar las noticias para el carrusel');
}
const json = await res.json();
const noticiasDestacadas = PostsSchema.parse(json); //aquí parseamos el json que nos devuelve la api para que sea un objeto de tipo PostSchema
---

<section class="relative w-full overflow-hidden  shadow-xl h-75 md:h-112.5 shrink-0">   <!--aquí el relative que la imagenes no se antepongan  y el hidden que se escondan hasta que se llame la otra el shrink-0 para que se mantenga el tamaño del carrusel y no se aplaste al hacerse pequeño --> 
      
    <div id="carrusel" class="flex w-full h-full transition-transform duration-700 ease-in-out"> <!-- ease-in-out hace que se cambien rapido al principio y en el centro y al final sea haga despacio -->
        
        {noticiasDestacadas.map((noticia: any) => (// aquí mapeamos las noticias que nos devuelve la api y las renderizamos en el carrusel
            <div class="w-full h-full shrink-0 relative">
               
                <img 
                    src={noticia.featured_images?.large?.url || noticia.featured_images?.medium?.url || ''} 
                    alt={noticia.title?.rendered || "Imagen de noticia"} 
                    class="w-full h-full object-cover"
                    loading="eager" 
                />
                
                
                <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
                    <div class="flex flex-col gap-3 max-w-xl md:max-w-2xl">
                        <a href={`/noticias/${noticia.slug}`} class="hover:underline">
                            <h1 class="text-xl md:text-5xl leading-tight font-medium font-display" set:html={noticia.title?.rendered}>
                            </h1>
                        </a>            
                        <!-- Muestra el subtítulo personalizado de ACF si existe, o el extracto por defecto -->
                        <h2 class="text-sm md:text-lg font-sans opacity-90 line-clamp-2" set:html={noticia.acf?.subtitulo || noticia.excerpt?.rendered}>
                        </h2>
                    </div>
                </div>
            </div>
        ))}
    </div>
    <button id="anterior-btn" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-20 h-20 rounded-full flex items-center justify-center transition-all z-20 focus:outline-none">
    ❮
    </button><!--los botones de las flechas llevan top y translate-y-1/2 q  ue hace que se centre muy bien, el z-20 es como la prioridad antes estaban en 10 y no se mostraban en las demas imagenes del carrusel -->
    
    <button id="despues-btn" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-20 h-20 rounded-full flex items-center justify-center transition-all z-20 focus:outline-none">
    ❯

    </button>
</section>


<script>
  const carrusel = document.getElementById('carrusel');
  const anteriorbtn = document.getElementById('anterior-btn'); 
  const despuesbtn = document.getElementById('despues-btn');

  // Lee de forma dinámica el número de elementos renderizados por el ciclo .map() de Astro
  const slides = carrusel ? Array.from(carrusel.children) : [];
  let indiceActual = 0;

  function mostrarSlide(indice: number) {
    if (!carrusel) return;
    carrusel.style.transform = `translateX(-${indice * 100}%)`;
  }

  despuesbtn?.addEventListener('click', () => {
    if (slides.length === 0) return;
    indiceActual = (indiceActual + 1) % slides.length;
    mostrarSlide(indiceActual);
  });

  anteriorbtn?.addEventListener('click', () => {
    if (slides.length === 0) return;
    indiceActual = (indiceActual - 1 + slides.length) % slides.length;
    mostrarSlide(indiceActual);
  });
</script>
</file>

<file path="src/pages/investigaciones/[slug].astro">
---
import Layout from "@/layouts/layout.astro";
import PostMeta from "@/components/noticias/PostMeta.astro";
import PostCategories from "@/components/noticias/PostCategories.astro";
import { InvestigacionSchema } from "@/types/index.ts";

export const prerender = false;

const { slug } = Astro.params;

// Petición al endpoint de investigaciones
const res = await fetch(`${import.meta.env.API_URL}/investigaciones?slug=${slug}`);
const json = await res.json();

const postValidation = InvestigacionSchema.safeParse(json[0]);
if (!postValidation.success) {
    return Astro.redirect('/404');
}

const investigacion = postValidation.data;
const imageUrl = investigacion.featured_images?.full?.url || investigacion.featured_images?.medium_large?.url || null;

// Datos del Autor (Extraídos desde WordPress vía API)
const autorNombre = investigacion.autor_custom?.nombre || 'Equipo de Investigación';
const autorAvatar = investigacion.autor_custom?.imagen?.thumbnail?.url 
                 || investigacion.autor_custom?.imagen?.medium?.url 
                 || null;
---

<Layout title={`${investigacion.title.rendered} - Acua Verde`}>
  <main class="w-full bg-white min-h-screen py-12">
    <article class="max-w-6xl mx-auto px-6 lg:px-8 space-y-10">
      
      <header class="space-y-6 text-center">
        {investigacion.category_details && investigacion.category_details.length > 0 && (
          <div class="flex flex-wrap justify-center gap-2">
            {investigacion.category_details.map(cat => (
              <span class="inline-block py-1 px-4 bg-acua-verde-600 text-white text-xs font-bold uppercase tracking-widest rounded-full">
                  {cat.name}
              </span>
            ))}
          </div>
        )}
        
        <h1 class="text-4xl md:text-6xl font-black text-gray-900 leading-tight" set:html={investigacion.title.rendered}></h1>
        
        <div class="flex items-center justify-center gap-4 border-b border-gray-200 pb-8 text-gray-600">
          <div class="flex items-center gap-3">
            {autorAvatar ? (
                <img 
                    src={autorAvatar} 
                    alt={`Avatar de ${autorNombre}`} 
                    class="w-10 h-10 rounded-full object-cover border border-gray-200"
                    loading="lazy"
                />
            ) : (
                <div class="w-10 h-10 rounded-full bg-acua-verde-100 flex items-center justify-center text-acua-verde-800 font-bold text-sm">
                    {autorNombre.charAt(0)}
                </div>
            )}
            <span class="font-medium text-gray-900">{autorNombre}</span>
          </div>
          
          <span class="text-gray-300 text-lg">&middot;</span>
          
          <PostMeta date={investigacion.date} />
        </div>
      </header>

      {imageUrl && (
        <div class="overflow-hidden rounded-xl shadow-lg w-full bg-acua-verde-100">
           <img 
             src={imageUrl} 
             alt={investigacion.title.rendered}
             class="w-full h-auto object-cover max-h-[600px]"
           />
        </div>
      )}

      <div class="prose prose-lg md:prose-xl max-w-none text-gray-800 leading-relaxed prose-a:text-acua-verde-600 hover:prose-a:text-acua-verde-800 prose-img:rounded-xl prose-img:shadow-md" set:html={investigacion.content.rendered}></div>
      
    </article>
  </main>
</Layout>
</file>

<file path="src/pages/noticias/[slug].astro">
---
import Layout from "@/layouts/layout.astro";
import PostMeta from "@/components/noticias/PostMeta.astro";
import PostCategories from "@/components/noticias/PostCategories.astro";
import { PostSchema } from "@/types/index.ts";

// Le dice a Astro que renderice esta página en el servidor (SSR) al momento de la petición, igual que en el curso
export const prerender = false;

const { slug } = Astro.params;

// Hacemos el fetch de la noticia específica
const res = await fetch(`${import.meta.env.API_URL}/noticia?slug=${slug}`);
const json = await res.json();

// Usamos safeParse. Si alguien escribe una URL falsa, lo manda a la página 404 en lugar de romper el sitio
const postValidation = PostSchema.safeParse(json[0]);
if (!postValidation.success) {
    return Astro.redirect('/404');
}

const post = postValidation.data;

// Intentamos usar la imagen full, si no hay, bajamos de resolución
const imageUrl = post.featured_images?.full?.url || post.featured_images?.medium_large?.url || null;

// Datos del Autor (Extraídos desde WordPress vía API)
const autorNombre = post.autor_custom?.nombre || 'Redacción Acua Verde';
const autorAvatar = post.autor_custom?.imagen?.thumbnail?.url 
                 || post.autor_custom?.imagen?.medium?.url 
                 || null;
---

<Layout title={`${post.title.rendered} - Acua Verde`}>
  <main class="w-full bg-acua-verde-50 min-h-screen py-12">
    <article class="max-w-6xl mx-auto px-6 lg:px-8 space-y-10">      
      <header class="space-y-6 text-center">
        {post.category_details && post.category_details.length > 0 && (
          <div class="flex flex-wrap justify-center">
            {post.category_details.map(cat => (
              <PostCategories name={cat.name} slug={cat.slug} />
            ))}
          </div>
        )}
        
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight" set:html={post.title.rendered}></h1>
        
        <div class="flex items-center justify-center gap-4 border-b border-gray-200 pb-8 text-gray-600">
          <div class="flex items-center gap-3">
            {autorAvatar ? (
                <img 
                    src={autorAvatar} 
                    alt={`Avatar de ${autorNombre}`} 
                    class="w-10 h-10 rounded-full object-cover border border-gray-200"
                    loading="lazy"
                />
            ) : (
                <div class="w-10 h-10 rounded-full bg-acua-verde-100 flex items-center justify-center text-acua-verde-800 font-bold text-sm">
                    {autorNombre.charAt(0)}
                </div>
            )}
            <span class="font-medium text-gray-900">{autorNombre}</span>
          </div>
          
          <span class="text-gray-300 text-lg">&middot;</span>
          
          <PostMeta date={post.date} />
        </div>
      </header>

      {imageUrl && (
        <div class="overflow-hidden rounded-2xl shadow-sm w-full bg-acua-verde-200">
           <img 
             src={imageUrl} 
             alt={post.title.rendered}
             class="w-full h-auto object-cover max-h-[500px]"
           />
        </div>
      )}

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed prose-a:text-acua-verde-600 hover:prose-a:text-acua-verde-800" set:html={post.content.rendered}></div>
      
    </article>
  </main>
</Layout>
</file>

