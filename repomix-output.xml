---
interface Props {
    name: string;
    slug: string;
}
const { name, slug } = Astro.props;
---

<span class="inline-block py-1 px-3 bg-acua-verde-100 text-xs text-acua-verde-800 font-semibold uppercase tracking-wider rounded mr-2 mb-2">
    {name}
</span>
</file>

<file path="src/components/ui/info.astro">
---
import Icon from "node_modules/astro-icon/components/Icon.astro"
import { OpcionesGlobalesSchema } from '@/types';

// Derivamos dinámicamente la URL base de tu API de entorno
const baseWpUrl = import.meta.env.API_URL.split('/wp/v2')[0];
const response = await fetch(`${baseWpUrl}/acuaverde/v1/opciones`);
const json = await response.json();
const opciones = OpcionesGlobalesSchema.parse(json);
---

<div class="w-full flex flex-col gap-6">
  <h3 class="text-xl font-bold text-gray-900 border-b border-gray-200 pb-2">
    Información de Contacto
  </h3>
  
  <div class="space-y-4 text-gray-600 text-base">
    <p class="flex items-center gap-3">
      <Icon name="mdi:account" class="w-5 h-5 text-acua-verde-600 shrink-0" />
      <span><strong>Representante:</strong> {opciones.contacto_nombre || "Acua Verde"}</span>
    </p>
    <p class="flex items-center gap-3">
      <Icon name="mdi:email" class="w-5 h-5 text-acua-verde-600 shrink-0" />
      <span><strong>Correo electrónico:</strong> <a href={`mailto:${opciones.contacto_email}`} class="hover:text-acua-verde-700 underline transition-colors">{opciones.contacto_email || "contacto@acuaverde.com"}</a></span>
    </p>
    <p class="flex items-center gap-3">
      <Icon name="mdi:phone" class="w-5 h-5 text-acua-verde-600 shrink-0" />
      <span><strong>Teléfono / WhatsApp:</strong> {opciones.contacto_numero || "+593 99 999 9999"}</span>
    </p>
  </div>

  <div class="pt-2">
    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Nuestras Redes Oficiales</p>
    <div class="flex items-center gap-3">
      {opciones.contacto_redes_instagram && (
        <a href={opciones.contacto_redes_instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="bg-gray-100 hover:bg-acua-verde-600 hover:text-white p-2.5 rounded-xl transition-all duration-200 text-gray-600 shadow-sm">
          <Icon name="mdi:instagram" class="w-5 h-5" />
        </a>
      )}
      {opciones.contacto_redes_x && (
        <a href={opciones.contacto_redes_x} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="bg-gray-100 hover:bg-acua-verde-600 hover:text-white p-2.5 rounded-xl transition-all duration-200 text-gray-600 shadow-sm">
          <Icon name="simple-icons:x" class="w-4 h-4" />
        </a>
      )}
      {opciones.contacto_redes_facebook && (
        <a href={opciones.contacto_redes_facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="bg-gray-100 hover:bg-acua-verde-600 hover:text-white p-2.5 rounded-xl transition-all duration-200 text-gray-600 shadow-sm">
          <Icon name="mdi:facebook" class="w-5 h-5" />
        </a>
      )}
    </div>
  </div>
</div>
</file>

<file path="src/pages/api/more-content.astro">
---
import { PostsSchema, InvestigacionesSchema } from '@/types/index.ts';
import NoticiasCard from '@/components/noticias/NoticiasCard.astro';
import InvestigacionCard from '@/components/investigaciones/InvestigacionCard.astro'; 

export const prerender = false;

const type = Astro.url.searchParams.get('type') || 'noticia';
const page = Astro.url.searchParams.get('page') || '2';

const wpEndpoint = type === 'investigacion' ? 'investigaciones' : 'noticia';
const url = `${import.meta.env.API_URL}/${wpEndpoint}?per_page=9&page=${page}`;

const res = await fetch(url);

if (!res.ok) {
    return new Response('', { status: 404 });
}

const json = await res.json();

// Declaramos explícitamente como any[] para evitar errores de tipo implícito ts(7034)
// y prevenir conflictos del compilador de Astro al renderizar componentes basados en uniones
let items: any[] = []; 

try {
    if (type === 'noticia') {
        items = PostsSchema.parse(json);
    } else if (type === 'investigacion') {
        items = InvestigacionesSchema.parse(json);
    }
} catch (error) {
    // Si una investigación de la página 2 tiene un formato inesperado en WordPress, 
    // este bloque evitará que la app colapse y verás el error detallado en tu terminal.
    console.error(`[Acua Verde API Error] Error al validar esquema Zod para ${type}:`, error);
    return new Response('', { status: 500 });
}
---

{items.map((item) => (
    type === 'noticia' 
        ? <NoticiasCard post={item} /> 
        : <InvestigacionCard investigacion={item} />
))}
</file>

<file path="src/pages/investigaciones/categoria/[slug].astro">
---
import Layout from '@/layouts/layout.astro';
import InvestigacionCard from '@/components/investigaciones/InvestigacionCard.astro';
import { InvestigacionesSchema, CategoriesSlugSchema, CategorySchema } from '@/types/index.ts';

export async function getStaticPaths() {
    // Apuntamos a la nueva taxonomía
    const res = await fetch(`${import.meta.env.API_URL}/categoria_investigacion?_fields=slug`);
    const json = await res.json();
    const categories = CategoriesSlugSchema.parse(json);
    
    return categories.map(category => ({
        params: { slug: category.slug }
    }));
}

const { slug } = Astro.params;

// Traemos los datos de la categoría específica de investigación
const catUrl = `${import.meta.env.API_URL}/categoria_investigacion?slug=${slug}`;
const catRes = await fetch(catUrl);
const catJson = await catRes.json();
const category = CategorySchema.parse(catJson[0]);

// Filtramos las investigaciones usando el ID de la taxonomía
const postsUrl = `${import.meta.env.API_URL}/investigaciones?categoria_investigacion=${category.id}`;
const postsRes = await fetch(postsUrl);
const postsJson = await postsRes.json();
const investigaciones = InvestigacionesSchema.parse(postsJson);
---

<Layout title={`Investigaciones sobre ${category.name} - Acua Verde`}>
  <main class="w-full bg-acua-verde-50 min-h-screen py-12">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      
      <div class="mb-10 border-b border-acua-verde-300 pb-4 flex flex-col gap-2">
          <span class="text-sm font-bold tracking-widest uppercase text-gray-500">Filtrando Investigaciones por:</span>
          <h1 class="text-4xl font-bold text-gray-800">
            {category.name}
          </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {investigaciones.length > 0 ? (
          investigaciones.map(investigacion => (
              <InvestigacionCard investigacion={investigacion} />
          ))
        ) : (
          <p class="text-gray-500 text-lg col-span-full">Aún no hay reportajes publicados en esta categoría.</p>
        )}
      </div>

    </div>
  </main>
</Layout>
</file>

<file path="src/pages/noticias/categoria/[slug].astro">
---
import Layout from '@/layouts/layout.astro';
import PostCard from '@/components/noticias/PostCard.astro';
import { PostsSchema, CategoriesSlugSchema, CategorySchema } from '@/types/index.ts';

// 1. Generamos las rutas estáticas de todas las categorías
export async function getStaticPaths() {
    const res = await fetch(`${import.meta.env.API_URL}/categories?_fields=slug`);
    const json = await res.json();
    const categories = CategoriesSlugSchema.parse(json);
    
    return categories.map(category => ({
        params: { slug: category.slug }
    }));
}

const { slug } = Astro.params;

// 2. Obtenemos el ID de la categoría actual a través de su slug
const catUrl = `${import.meta.env.API_URL}/categories?slug=${slug}`;
const catRes = await fetch(catUrl);
const catJson = await catRes.json();
const category = CategorySchema.parse(catJson[0]);

// 3. Traemos exclusivamente las noticias que pertenezcan a ese ID
const postsUrl = `${import.meta.env.API_URL}/noticia?categories=${category.id}`;
const postsRes = await fetch(postsUrl);
const postsJson = await postsRes.json();
const posts = PostsSchema.parse(postsJson);
---

<Layout title={`Noticias de ${category.name} - Acua Verde`}>
  <main class="w-full bg-acua-verde-50 min-h-screen py-12">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      
      <!-- Título dinámico -->
      <h1 class="text-4xl font-bold text-gray-800 mb-10 border-b border-gray-300 pb-4">
        Noticias sobre: <span class="text-acua-verde-600">{category.name}</span>
      </h1>

      <!-- Reutilizamos el Grid de tarjetas iterando sobre los posts filtrados -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {posts.length > 0 ? (
          posts.map(post => (
              <PostCard post={post} />
          ))
        ) : (
          <p class="text-gray-500 text-lg col-span-full">Aún no hay noticias publicadas en esta categoría.</p>
        )}
      </div>

    </div>
  </main>
</Layout>
</file>

