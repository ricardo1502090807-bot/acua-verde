<?php

// 1. FORMATO ESTÁNDAR DE ACF
add_filter('acf/settings/rest_api_format', function() {
    return "standard";
});

// 2. SOPORTE DEL TEMA
function acuaverde_setup() {
    add_theme_support('post-thumbnails');
}
add_action('after_setup_theme', 'acuaverde_setup');

// 3. REGISTRO DE CUSTOM POST TYPES (CPT)
function acuaverde_registrar_cpt_noticias() {
    // A. Nuevo apartado de Noticias separado de los posts nativos
    register_post_type('noticia', array(
        'labels' => array(
            'name'          => 'Noticias',
            'singular_name' => 'Noticia',
            'menu_name'     => 'Noticias',
            'add_new_item'  => 'Añadir nueva Noticia',
        ),
        'public'       => true,
        'has_archive'  => true,
        'show_in_rest' => true, // Soporte nativo para la API REST
        'menu_icon'    => 'dashicons-megaphone',
        'supports'     => array('title', 'editor', 'thumbnail', 'excerpt'),
        'taxonomies'   => array('category') // Asignamos las categorías estándar
    ));
}
add_action('init', 'acuaverde_registrar_cpt_noticias');

// 4. INICIALIZADOR DE LA API REST
function acuaverde_api_init() {
    
    // A. Imágenes Destacadas (Añadimos 'noticia' junto a page, post e investigacion)
    register_rest_field(
        array('page', 'post', 'investigacion', 'noticia'),
        'featured_images',
        array('get_callback' => 'get_featured_images')
    );

    // B. Categorías de Noticias (post nativo y ahora también el CPT 'noticia')
    register_rest_field(
        array('post', 'noticia'),
        'category_details',
        array('get_callback' => 'get_post_categories')
    );

    // C. Categorías de Investigaciones (tu nueva taxonomía de ACF)
    register_rest_field(
        array('investigacion'),
        'category_details',
        array('get_callback' => 'get_investigacion_categories')
    );

    // D. Tus campos personalizados para Páginas (Nosotros)
    register_rest_field(
        array('page'),
        'acf_images_urls',
        array('get_callback' => 'get_acf_custom_images')
    );

    // E. Datos del Autor Personalizado (para Noticias e Investigaciones)
    register_rest_field(
        array('noticia', 'investigacion'),
        'autor_custom',
        array('get_callback' => 'get_custom_author_data')
    );
}
add_action('rest_api_init', 'acuaverde_api_init');

// ================= CALLBACKS =================

function get_featured_images( $post ) {
    // Exacto al curso
    if(!$post['featured_media']) {
        return false;
    }
    $image_sizes = get_intermediate_image_sizes();
    $images = array();
    
    foreach($image_sizes as $size){
        if($size === "2048x2048") continue;
        $image = wp_get_attachment_image_src($post['featured_media'], $size);
        
        if (!$image) continue;
        
        $images[$size === '1536x1536' ? 'full' : $size] = array(
            'url' => $image[0],
            'width' => $image[1],
            'height' => $image[2]
        );
    }
    return $images;
}

function get_post_categories( $post ){
    // Exacto al curso (ahora incluyendo 'id' => $cat['term_id'])
    if (empty($post['categories'])) return [];
    
    return array_map(
        function($category_id){
            $cat = get_category($category_id, 'ARRAY_A');
            return [
                'id'   => $cat['term_id'],
                'name' => $cat['name'],
                'slug' => $cat['slug'],
            ];
        },
        $post['categories']
    );
}

function get_investigacion_categories( $post ){
    // Lo mismo que arriba, pero para tu taxonomía personalizada de ACF
    if (empty($post['categoria_investigacion'])) return [];
    
    return array_map(
        function($term_id){
            $term = get_term($term_id, 'categoria_investigacion', 'ARRAY_A');
            return [
                'id'   => $term['term_id'],
                'name' => $term['name'],
                'slug' => $term['slug'],
            ];
        },
        $post['categoria_investigacion']
    );
}

function get_acf_custom_images($post) {
    // Tu función mantenida para Nosotros.astro
    $acf_images = array();
    $campos = ['imagen_uno', 'imagen_dos', 'imagen_tres'];
    foreach ($campos as $campo) {
        $img_id = get_post_meta($post['id'], $campo, true);
        if ($img_id) {
            $acf_images[$campo] = get_featured_images(array('featured_media' => $img_id));
        }
    }
    return $acf_images;
}

function get_custom_author_data($post) {
    // Usamos los nombres exactos configurados en ACF (autor_name y autor_image)
    $nombre = get_field('autor_name', $post['id']);
    $imagen_id = get_field('autor_image', $post['id']);
    
    $imagen_data = null;
    
    // Si hay una imagen subida, reciclamos tu función get_featured_images
    if ($imagen_id) {
        $imagen_data = get_featured_images(array('featured_media' => $imagen_id));
    }
    
    return array(
        'nombre' => $nombre ? $nombre : 'Redacción Acua Verde',
        'imagen' => $imagen_data
    );
}

// ENDPOINT GLOBAL ACUAVERDE
function registrar_endpoint_opciones_globales() {
    register_rest_route('acuaverde/v1', '/opciones', array(
        'methods' => 'GET',
        'callback' => function() {
            $page_id = 53; 
            return array(
                'contacto_nombre'          => get_field('contacto_nombre', $page_id),
                'contacto_email'           => get_field('contacto_email', $page_id),
                'contacto_numero'          => get_field('contacto_numero', $page_id),
                'contacto_redes_instagram' => get_field('contacto_redes_instagram', $page_id),
                'contacto_redes_x'         => get_field('contacto_redes_x', $page_id),
                'contacto_redes_facebook'  => get_field('contacto_redes_facebook', $page_id),
            );
        },
    ));
}
add_action('rest_api_init', 'registrar_endpoint_opciones_globales');

