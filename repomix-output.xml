<file path="src/pages/investigaciones/[slug].astro">
---
import Layout from "@/layouts/layout.astro";
import PostMeta from "@/components/shared/PostMeta.astro";
import AutorInfo from "@/components/shared/AutorInfo.astro";
import { InvestigacionSchema } from "@/types/index.ts";

export const prerender = false;

const { slug } = Astro.params;

const res = await fetch(`${import.meta.env.API_URL}/investigaciones?slug=${slug}`);

if (!res.ok) {
    return Astro.redirect('/404');
}

const json = await res.json();

const postValidation = InvestigacionSchema.safeParse(json[0]);
if (!postValidation.success) {
    return Astro.redirect('/404');
}

const investigacion = postValidation.data;
const imageUrl = investigacion.featured_images?.full?.url || investigacion.featured_images?.medium_large?.url || null;

const autorNombre = investigacion.autor_custom?.nombre || 'Equipo de Investigación';
const autorAvatar = investigacion.autor_custom?.imagen?.thumbnail?.url
                 || investigacion.autor_custom?.imagen?.medium?.url
                 || null;
---

<Layout title={`${investigacion.title.rendered} - Acua Verde`}>
  <main class="w-full bg-white min-h-screen py-12">
    <article class="max-w-6xl mx-auto px-6 lg:px-8 space-y-10">

      <header class="space-y-6 text-center">
        {investigacion.category_details && investigacion.category_details.length > 0 && (
          <div class="flex flex-wrap justify-center gap-2">
            {investigacion.category_details.map(cat => (
              <span class="inline-block py-1 px-4 bg-acua-verde-600 text-white text-xs font-bold uppercase tracking-widest rounded-full">
                  {cat.name}
              </span>
            ))}
          </div>
        )}

        <h1 class="text-4xl md:text-6xl font-black text-gray-900 leading-tight" set:html={investigacion.title.rendered}></h1>

        <div class="flex items-center justify-center gap-4 border-b border-gray-200 pb-8 text-gray-600">
          <AutorInfo nombre={autorNombre} avatar={autorAvatar} size="lg" />

          <span class="text-gray-300 text-lg">&middot;</span>

          <PostMeta date={investigacion.date} />
        </div>
      </header>

      {imageUrl && (
        <div class="overflow-hidden rounded-xl shadow-lg w-full bg-acua-verde-100">
           <img
             src={imageUrl}
             alt={investigacion.title.rendered}
             class="w-full h-auto object-cover max-h-[600px]"
           />
        </div>
      )}

