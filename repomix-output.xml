<file path="src/components/investigaciones/InvestigacionCard.astro">
---
import type { Investigacion } from '@/types/index.ts';
// Reutilizamos los componentes de noticias ¡Magia de Astro!
import PostMeta from '../noticias/PostMeta.astro';
import PostCategories from '../noticias/PostCategories.astro';

interface Props {
    investigacion: Investigacion;
}

const { investigacion } = Astro.props;

const imageUrl = investigacion.featured_images?.medium_large?.url 
              || investigacion.featured_images?.medium?.url 
              || null;

// Datos del Autor personalizados desde el backend
const autorNombre = investigacion.autor_custom?.nombre || 'Equipo de Investigación';
const autorAvatar = investigacion.autor_custom?.imagen?.thumbnail?.url 
                 || investigacion.autor_custom?.imagen?.medium?.url 
                 || null;
---

<article class="flex flex-col group h-full bg-white rounded-2xl shadow-sm border border-acua-verde-100 p-4 hover:shadow-md transition-shadow duration-300">
    <div class="overflow-hidden rounded-xl aspect-[3/2] mb-4 bg-acua-verde-200 flex items-center justify-center">
        {imageUrl ? (
            <img 
                src={imageUrl} 
                alt={investigacion.title.rendered}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
            />
        ) : (
            <span class="text-acua-verde-800 font-medium tracking-wide opacity-50">Investigación</span>
        )}
    </div>

    <h2 class="text-xl font-bold text-gray-900 leading-snug mb-3 group-hover:text-acua-verde-600 transition-colors">
        <a href={`/investigaciones/${investigacion.slug || investigacion.id}`} set:html={investigacion.title.rendered}></a>
    </h2>

    {investigacion.category_details && investigacion.category_details.length > 0 && (
        <div class="flex flex-wrap mb-2">
            {investigacion.category_details.map(cat => (
                // Pasamos una prop extra (si quisieras adaptarlo) o usamos la base.
                // IMPORTANTE: el href en PostCategories asume /noticias/categoria/. 
                // Como es reutilizado, si le dan clic irá allá. Lo ideal sería pasarle la ruta base como prop en el futuro.
                <PostCategories name={cat.name} slug={cat.slug} />
            ))}
        </div>
    )}

    <div set:html={investigacion.content.rendered} class="line-clamp-2 text-gray-600 text-sm mb-4"></div>

    {/* SECCIÓN DEL AUTOR Y METADATOS */}
    <div class="mt-auto flex items-center justify-between pt-4 border-t border-gray-100">
        <div class="flex items-center gap-3">
            {autorAvatar ? (
                <img 
                    src={autorAvatar} 
                    alt={`Avatar de ${autorNombre}`} 
                    class="w-8 h-8 rounded-full object-cover border border-gray-200"
                    loading="lazy"
                />
            ) : (
                <div class="w-8 h-8 rounded-full bg-acua-verde-100 flex items-center justify-center text-acua-verde-800 font-bold text-xs">
                    {autorNombre.charAt(0)}
                </div>
            )}
            <span class="text-sm font-medium text-gray-700">{autorNombre}</span>
        </div>
        
        <PostMeta date={investigacion.date} />
    </div>
</article>
</file>

<file path="src/components/noticias/NoticiasGrid.astro">
---
import { PostsSchema } from '@/types/index.ts'; 
import PostCard from './NoticiasCard.astro';

const url = `${import.meta.env.API_URL}/noticia?per_page=9&page=1`;
const res = await fetch(url);

if (!res.ok) {
  throw new Error('No se pudieron cargar las noticias de WordPress');
}

const json = await res.json();
const posts = PostsSchema.parse(json); 
const totalPages = parseInt(res.headers.get('x-wp-totalpages') || '1', 10);
---

{/* Añadimos data-type="noticia" para que el JS sea reutilizable */}
<div class="content-wrapper" data-total-pages={totalPages} data-type="noticia">
  <div class="content-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
    {posts.map((post) => (
        <PostCard post={post} />
    ))}
  </div>

  {totalPages > 1 && (
    <div class="load-more-container flex justify-center mt-16">
      <button 
        class="load-more-btn px-8 py-3 bg-acua-verde-600 text-white font-semibold rounded-xl shadow-sm hover:bg-acua-verde-700 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Cargar más noticias
      </button>
    </div>
  )}
</div>

{/* Script totalmente genérico usando clases en lugar de IDs */}
<script>
  const wrappers = document.querySelectorAll('.content-wrapper');

  wrappers.forEach(wrapper => {
    const grid = wrapper.querySelector('.content-grid');
    const btn = wrapper.querySelector('.load-more-btn') as HTMLButtonElement;
    const btnContainer = wrapper.querySelector('.load-more-container');

    if (grid && btn) {
      const totalPages = parseInt(wrapper.getAttribute('data-total-pages') || '1', 10);
      const contentType = wrapper.getAttribute('data-type') || 'noticia';
      let currentPage = 1;

      btn.addEventListener('click', async () => {
        currentPage++;
        btn.disabled = true;
        btn.innerText = 'Cargando...';

        try {
          // El fetch ahora es dinámico usando el contentType variable
          const response = await fetch(`/api/more-content?type=${contentType}&page=${currentPage}`);
          
          if (response.ok) {
            const html = await response.text();
            grid.insertAdjacentHTML('beforeend', html);
          }
        } catch (error) {
          console.error('Error al cargar más contenido:', error);
        } finally {
          btn.disabled = false;
          btn.innerText = `Cargar más ${contentType === 'noticia' ? 'noticias' : 'investigaciones'}`;

          if (currentPage >= totalPages && btnContainer) {
            btnContainer.remove();
          }
        }
      });
    }
  });
</script>
</file>

